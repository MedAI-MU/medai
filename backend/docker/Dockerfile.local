###############################
# Stage 1 — Builder
###############################
FROM node:24-alpine AS builder
SHELL ["/bin/sh", "-c", "-o", "pipefail"]

ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:${PATH}"

# Install pnpm globally
RUN npm install -g pnpm

# Create app directory and medai user
RUN addgroup -S medai \
    && adduser -S -h /medai -G medai medai \
    && mkdir -p /medai \
    && chown -R medai:medai /medai

WORKDIR /medai

# Copy package files
COPY --chown=medai:medai package.json pnpm-lock.yaml ./

# Install deps AS medai user (important!)
USER medai
RUN pnpm install --frozen-lockfile

# Copy project files
COPY --chown=medai:medai . .

# Build the project — dist/ will now be owned by medai
RUN pnpm build


###############################
# Stage 2 — Runtime
###############################
FROM node:24-alpine
SHELL ["/bin/sh", "-c", "-o", "pipefail"]

# Create medai user
RUN addgroup -S medai \
    && adduser -S -h /medai -G medai medai \
    && mkdir -p /medai \
    && chown -R medai:medai /medai

WORKDIR /medai

# OPTIONAL: install pg client if migrations or scripts need it
RUN apk add --no-cache postgresql-client

# Copy built files and node_modules from builder
COPY --from=builder --chown=medai:medai /medai/node_modules ./node_modules
COPY --from=builder --chown=medai:medai /medai/dist ./dist
COPY --from=builder --chown=medai:medai /medai/package.json ./package.json

USER medai

EXPOSE 8000

CMD ["node", "dist/src/main.js"]
