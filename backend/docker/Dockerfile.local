###############################
# Stage 1 — Builder
###############################
FROM node:24-alpine AS builder
SHELL ["/bin/sh", "-c", "-o", "pipefail"]

# Set pnpm path
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:${PATH}"

# Install pnpm globally
RUN npm install -g pnpm

# Create working directory
WORKDIR /medai

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Remove old dist if exists
RUN rm -rf dist

# Build the project
RUN pnpm build

###############################
# Stage 2 — Runtime
###############################
FROM node:24-alpine
SHELL ["/bin/sh", "-c", "-o", "pipefail"]

WORKDIR /medai

# Install runtime utilities (optional)
RUN apk add --no-cache postgresql-client

# Copy built files and node_modules from builder
COPY --from=builder /medai/node_modules ./node_modules
COPY --from=builder /medai/dist ./dist
COPY --from=builder /medai/package.json ./package.json

# Expose port 8000
EXPOSE 8000

# Run as non-root user
RUN addgroup -S medai && adduser -S -G medai medai
USER medai

# Start the NestJS app
CMD ["node", "dist/src/main.js"]
