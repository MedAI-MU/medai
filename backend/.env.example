APP_PORT=8000

DB_NAME=medai_db
DB_USERNAME=medai
DB_PASSWORD=password
DB_HOST=medai-db
DB_PORT=5432

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=900000 # 15 minutes in ms
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key
REFRESH_TOKEN_EXPIRATION=604800000 # 7 days in ms
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@example.com
BREVO_SMTP_PASS=xsmtpsib-your-generated-smtp-key
BREVO_DEFAULT_FROM="Your App Name" <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:3000

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net

# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Server (voice-to-clinical-report pipeline)
AI_SERVER_URL=http://ai-server:80/api/v1/pipeline
MEDAI_API_KEY=medai-secret-key
AI_SERVER_TIMEOUT_MS=300000
UPLOAD_DIR=uploads

# Lab Report Analysis AI Server
LAB_AI_SERVER_URL=http://lab-ai-server:8000
LAB_AI_SERVER_TIMEOUT_MS=1800000
